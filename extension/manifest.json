{
  "manifest_version": 3,
  "name": "Furna",
  "version": "0.2.0",
  "description": "Mark and expand what you're reading, on any page — your own OpenRouter key or a local server, settings and the entity list in the side panel.",
  "action": {},
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/markdown.js", "content/content.js"],
      "css": ["content/marks.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/panel.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"]
}
