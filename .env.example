# --------------------------------------------------------------------------- #
# Default provider for every role: local | anthropic
# --------------------------------------------------------------------------- #
LLM_PROVIDER=local

# --- Local model (OpenAI-compatible server) --------------------------------- #
# LM Studio: http://localhost:1234/v1   ·   Ollama: http://localhost:11434/v1
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=nvidia/nemotron-3-nano-4b
LOCAL_API_KEY=not-needed
LOCAL_TIMEOUT=600
# Upper bound on completion tokens. It is only a ceiling: when the model's real
# context window can be discovered, the code sizes each request to fit that
# instead. Reasoning models spend most of this before writing any answer.
LOCAL_MAX_TOKENS=8000
# Long documents are extracted in chunks, this many at a time. Raise it for a
# remote provider; a single local model gains little from going wider.
EXTRACTION_CONCURRENCY=3

# --- OpenRouter -------------------------------------------------------------- #
# The `:free` models are a useful middle ground: far larger context windows than
# a 4B running locally, no cost, but rate-limited and slower under load.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer / X-Title; OpenRouter uses them to attribute usage.
OPENROUTER_SITE=http://localhost:8787
OPENROUTER_TITLE=Furna

# --- Anthropic -------------------------------------------------------------- #
# Only needed if some role uses the 'anthropic' provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Per-role model (optional) ---------------------------------------------- #
# Accepts "model" (uses LLM_PROVIDER) or "provider:model".
# The useful hybrid: cheap local extraction, strong remote synthesis.
# EXTRACTOR_MODEL=local:nvidia/nemotron-3-nano-4b
# EXPANDER_MODEL=openrouter:inclusionai/ling-3.0-flash:free
# SUBAGENT_MODEL=anthropic:claude-sonnet-5

# --- Subagents -------------------------------------------------------------- #
# Empty = on for Anthropic, off for local (a 4B model rarely survives
# orchestrating three delegations). Force with 1 or 0.
# EXPANDER_SUBAGENTS=
