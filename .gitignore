# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.cache/
.env
node_modules

# Chrome "Pack extension" output. The .pem is the PRIVATE SIGNING KEY: anyone
# who has it can publish an update Chrome accepts as this same extension id.
# It must never be committed. The .crx is a build artifact — rebuildable, and
# not needed at all for development, where "Load unpacked" is the right path.
*.pem
*.crx
